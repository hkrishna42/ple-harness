{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python 3.12 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python 3.12 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" post || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python 3.12 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" start || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet --python 3.12 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" stop || true"
          }
        ]
      }
    ]
  }
}
